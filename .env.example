# Demo identities are not authentication. Never deploy this mode publicly.
MUTUAL_MODE=demo
# Optional shell override; defaults to backend/mutual.db.
# MUTUAL_DATABASE_PATH=/absolute/path/to/mutual.db
# Calendar selection follows MUTUAL_MODE: demo=mock, google=real.
# mock = deterministic demo; local = bounded negotiation through local Ollama
AGENT_ADAPTER=mock
# Used when AGENT_ADAPTER=local (requires a running local Ollama + pulled model)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=60
# 1 = explicitly labeled deterministic fallback on model failure; 0 = fail
AGENT_LOCAL_FALLBACK=1
# Backend caps review rounds at 3 and total negotiation time at 120 seconds.
AGENT_MAX_ROUNDS=3
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/calendar/oauth/callback
VITE_API_BASE_URL=http://localhost:8000
# MUTUAL_MODE=google enables real sign-in and real calendar operations.
# Demo headers are rejected in Google mode; never use demo mode for real users.
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=0
# Generate once, keep private and stable across restarts:
# .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MUTUAL_TOKEN_KEY=
# Optional alternative to GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above:
# GOOGLE_CREDENTIALS_FILE=/absolute/path/to/oauth-web-client.json
