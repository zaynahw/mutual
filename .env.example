# Demo identities are not authentication. Never deploy this mode publicly.
MUTUAL_MODE=demo
# Optional shell override; defaults to backend/mutual.db.
# MUTUAL_DATABASE_PATH=/absolute/path/to/mutual.db
CALENDAR_ADAPTER=mock
# mock = passthrough; local = offline Ollama ranking via agent/
AGENT_ADAPTER=mock
# Used when AGENT_ADAPTER=local (requires a running local Ollama + pulled model)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=60
# 1 = fall back to deterministic plan / original order if the local model fails; 0 = raise
AGENT_LOCAL_FALLBACK=1
# Bounded two-agent negotiate rounds (invitee review count budget)
AGENT_MAX_ROUNDS=3
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/calendar/oauth/callback
VITE_API_BASE_URL=http://localhost:8000
